# generate the secrets with: python scripts/gen_keys.py
DATABASE_URL=sqlite:///./aegis.db
JWT_SECRET=
APP_SECRET=
AES_PII_KEY_B64=
AES_EVIDENCE_KEY_B64=
HMAC_KEY_B64=
ED25519_PRIVATE_KEY_HEX=
INITIAL_ADMIN_EMAIL=you@example.org
ALLOWED_EMAILS=
ALLOWED_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://your-host/auth/callback
BLOB_DIR=./blobs        # dev only; leave empty and set S3_BUCKET in production
S3_BUCKET=
COOKIE_SECURE=1
ALLOWED_ORIGINS=https://your-host   # required behind a proxy that rewrites Host
MAX_PENDING_SIGNUPS=500
PENDING_TTL_DAYS=7
UPLOAD_IDLE_SECONDS=20
MAX_UPLOAD_BYTES=26214400
